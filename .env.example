SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://shopify.aiml.chat
SCOPES=read_products,read_content,read_themes,write_themes
DATABASE_URL=file:dev.sqlite

# AIML.chat backend — used to register stores and trigger ingestion
AIML_API_URL=https://api.aiml.chat
# Service token with admin scope to register websites on behalf of Shopify installs
AIML_SERVICE_TOKEN=
