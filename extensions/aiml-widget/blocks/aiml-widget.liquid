{% comment %}
  AIML Chat Widget — Theme App Extension block
  Inject into storefront via Online Store > Themes > Customize > App embeds

  Appearance (colours, avatar, launcher, greeting, auto-open…) is managed centrally in the
  AIML.chat dashboard. Settings here are per-store OVERRIDES: when left on "Default", no
  data-attribute is emitted and the dashboard configuration applies.
{% endcomment %}

{% if block.settings.enabled %}
  <script
    src="https://cdn.aiml.chat/v1/widget.js"
    data-api-key="{{ block.settings.api_key }}"
    data-website-id="{{ block.settings.website_id }}"
    {% if block.settings.position != blank %}
      data-position="{{ block.settings.position }}"
    {% endif %}
    {% if block.settings.theme != blank %}
      data-theme="{{ block.settings.theme }}"
    {% endif %}
    {% if block.settings.primary_color != blank %}
      data-primary-color="{{ block.settings.primary_color }}"
    {% endif %}
    async
    defer>
  </script>
{% endif %}

{% schema %}
{
  "name": "AIML Chat",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable chat widget",
      "default": true
    },
    {
      "type": "text",
      "id": "api_key",
      "label": "API Key",
      "info": "Find your API key in the AIML Chat app"
    },
    {
      "type": "text",
      "id": "website_id",
      "label": "Website ID",
      "info": "Find your Website ID in the AIML Chat app"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Widget position",
      "options": [
        { "value": "", "label": "Default (use dashboard setting)" },
        { "value": "right", "label": "Bottom right" },
        { "value": "left", "label": "Bottom left" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "theme",
      "label": "Colour theme",
      "options": [
        { "value": "", "label": "Default (use dashboard setting)" },
        { "value": "auto", "label": "Auto (follow system)" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": ""
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary colour",
      "info": "Optional override — leave unset to use the colour from your AIML.chat dashboard"
    }
  ]
}
{% endschema %}
